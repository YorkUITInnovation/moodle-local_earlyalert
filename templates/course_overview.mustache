<div class="row">
    <div class="col">
        <h3>{{#str}}my_list_of_students, local_earlyalert{{/str}} - {{#str}}alerts_raised, local_earlyalert{{/str}}</h3>
    </div>
</div>
<div class="row">
    <div class="col">
        {{#str}}course_overview_render_instructions, local_earlyalert{{/str}}
    </div>
</div>
<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-header bg-white">
                <h5>{{#str}}course, core{{/str}}: {{course_name}}</h5>
            </div>
            <div class="card-body">
                <div class="accordion" id="accordionCourseOverview">
                    {{#students}}
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading{{id}}">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapse{{id}}"
                                        aria-expanded="false" aria-controls="collapse{{id}}">
                                    {{lastname}}, {{firstname}} ({{idnumber}})
                                </button>
                            </h2>
                            <div id="collapse{{id}}" class="accordion-collapse collapse"
                                 aria-labelledby="heading{{id}}" data-bs-parent="#accordionCourseOverview">
                                <div class="accordion-body py-2">
                                    {{#logs}}
                                        <div class="early-alert-log-item {{#is_commendation}}early-alert-log-item--commendation{{/is_commendation}}">
                                            <div class="early-alert-log-summary">
                                                <div class="early-alert-log-heading">
                                                    <span class="early-alert-log-type {{#is_commendation}}early-alert-log-type--commendation{{/is_commendation}}">
                                                        {{#is_commendation}}<span class="early-alert-log-type-icon" aria-hidden="true">🎉</span>{{/is_commendation}}
                                                        <span>{{message_type}}</span>
                                                    </span>
                                                    <span class="early-alert-log-date">{{date_sent}}</span>
                                                </div>
                                            </div>
                                            <div class="early-alert-log-actions">
                                                <button type="button" class="btn btn-primary btn-sm btn-early-alert-preview-message" data-logid="{{id}}">
                                                    {{#str}}view_message, local_earlyalert{{/str}}
                                                </button>
                                            </div>
                                            <div class="early-alert-log-status">
                                                <div class="early-alert-followup-list">
                                                    {{#is_commendation}}
                                                        <span class="early-alert-followup-pill early-alert-followup-pill--commendation">
                                                            <span class="early-alert-followup-pill__icon" aria-hidden="true">★</span>
                                                             {{#str}}positive_outreach, local_earlyalert{{/str}}
                                                        </span>
                                                    {{/is_commendation}}
                                                    {{^is_commendation}}
                                                        <span class="early-alert-followup-pill {{#student_advised_by_instructor}}early-alert-followup-pill--done{{/student_advised_by_instructor}}{{^student_advised_by_instructor}}early-alert-followup-pill--pending{{/student_advised_by_instructor}}">
                                                            <span class="early-alert-followup-pill__icon" aria-hidden="true">{{#student_advised_by_instructor}}✓{{/student_advised_by_instructor}}{{^student_advised_by_instructor}}○{{/student_advised_by_instructor}}</span>
                                                            Instructor/TA {{#student_advised_by_instructor}}followed up{{/student_advised_by_instructor}}{{^student_advised_by_instructor}}pending{{/student_advised_by_instructor}}
                                                        </span>
                                                        <span class="early-alert-followup-pill {{#student_advised_by_advisor}}early-alert-followup-pill--done{{/student_advised_by_advisor}}{{^student_advised_by_advisor}}early-alert-followup-pill--pending{{/student_advised_by_advisor}}">
                                                            <span class="early-alert-followup-pill__icon" aria-hidden="true">{{#student_advised_by_advisor}}✓{{/student_advised_by_advisor}}{{^student_advised_by_advisor}}○{{/student_advised_by_advisor}}</span>
                                                            Advisor {{#student_advised_by_advisor}}followed up{{/student_advised_by_advisor}}{{^student_advised_by_advisor}}pending{{/student_advised_by_advisor}}
                                                        </span>
                                                    {{/is_commendation}}
                                                </div>
                                            </div>
                                        </div>
                                    {{/logs}}
                                </div>
                            </div>
                        </div>
                    {{/students}}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add AMD js to call course_overview_updating.js -->
{{#js}}
    require(['local_earlyalert/course_overview_updating'], function (course_overview_updating) {
        course_overview_updating.init();
    });
{{/js}}