<div class="row">
    <div class="col-md-12">
        {{#str}}student_lookup_instructions, local_earlyalert{{/str}}
    </div>
</div>
<div class="accordion" id="accordionStudentCourses">
    {{#courses}}
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading{{id}}">
                <button class="accordion-button collapsed {{#has_alerts}}bg-danger text-white{{/has_alerts}}"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse{{id}}"
                        aria-expanded="false"
                        aria-controls="collapse{{id}}">
                    <span>{{fullname}} ({{idnumber}})</span>
                    {{#has_alerts}}
                        <span class="ms-2"><i class="fa fa-exclamation-circle fa-lg text-white"></i></span>
                    {{/has_alerts}}
                </button>
            </h2>

            <div id="collapse{{id}}" class="accordion-collapse collapse" aria-labelledby="heading{{id}}" data-bs-parent="#accordionStudentCourses">
                <div class="accordion-body">
                    {{#alerts}}
                        <div class="row early-alert-alert-row {{#is_commendation}}early-alert-commendation-row{{/is_commendation}}">
                            <div class="col-md-6">
                                {{#is_commendation}}<strong>{{message_type}}</strong> - {{date_sent}} <i class="fa fa-champagne-glasses fa-lg text-success ms-2"></i>{{/is_commendation}}{{^is_commendation}}{{message_type}} - {{date_sent}}{{/is_commendation}}
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-early-alert-preview-message {{#is_commendation}}btn-outline-success{{/is_commendation}}{{^is_commendation}}btn-primary{{/is_commendation}}" data-logid="{{id}}">
                                    {{#str}}view_message, local_earlyalert{{/str}}
                                </button>
                            </div>
                            <div class="col-md-4 d-flex justify-content-end">
                                <table class="table table-borderless table-sm {{#is_commendation}}invisible{{/is_commendation}}" {{#is_commendation}}aria-hidden="true"{{/is_commendation}}>
                                    <thead class="table-light">
                                    <tr>
                                        <th>
                                            <div class="d-flex justify-content-center">
                                                Instructor/TA
                                            </div>

                                        </th>
                                        <th>
                                            <div class="d-flex justify-content-center">
                                                Advisor
                                            </div>
                                        </th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                <input type="checkbox" class="checkbox-instructor-followup"
                                                       data-logid="{{id}}"
                                                       tabindex="{{#is_commendation}}-1{{/is_commendation}}{{^is_commendation}}0{{/is_commendation}}"
                                                       {{#student_advised_by_instructor}}checked{{/student_advised_by_instructor}}
                                                       {{#disabled_instructor}}disabled{{/disabled_instructor}}
                                                       {{#is_commendation}}disabled{{/is_commendation}}>
                                            </div>

                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                <input  type="checkbox" class="checkbox-advisor-followup"
                                                        data-logid="{{id}}"
                                                        tabindex="{{#is_commendation}}-1{{/is_commendation}}{{^is_commendation}}0{{/is_commendation}}"
                                                        {{#student_advised_by_advisor}}checked{{/student_advised_by_advisor}}
                                                        {{#disabled_advisor}}disabled{{/disabled_advisor}}
                                                        {{#is_commendation}}disabled{{/is_commendation}}>
                                            </div>
                                        </td>
                                    </tr>
                                    </tbody>

                                </table>
                            </div>
                        </div>
                    {{/alerts}}
                </div>
            </div>
        </div>
    {{/courses}}
</div>

<!-- Add AMD js to call course_overview_updating.js -->
{{#js}}
    require(['local_earlyalert/course_overview_updating'], function (course_overview_updating) {
    course_overview_updating.init();
    });
{{/js}}
