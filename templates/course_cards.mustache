<div class="earlyalert-redesign" id="earlyalert-dashboard"
     data-teacher-user-id="{{teacher_user_id}}"
     data-show-grades="{{show_grades}}">
    <input type="hidden" id="early-alert-teacher-user-id" value="{{teacher_user_id}}">

    {{#impersonate}}
        <div class="row mb-4">
            <div class="col-md-4">
                <label for="search" class="form-label">{{#str}}impersonate_user, local_earlyalert{{/str}}</label>
                <select id="search" class="form-select" data-placeholder="{{#str}}search, core{{/str}}">
                    <option value="{{impersonate_selected_user_id}}"
                            selected>{{impersonate_selected_user_label}}</option>
                </select>
            </div>
        </div>
    {{/impersonate}}

    <div id="earlyalert-dashboard-view" data-region="dashboard-view">
        <!-- Title removed per design -->

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{#str}}metric_total_alerts, local_earlyalert{{/str}}</div>
                        <div class="display-6 fw-bold">{{metric_total_alerts}}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{#str}}metric_students_at_risk, local_earlyalert{{/str}}</div>
                        <div class="display-6 fw-bold">{{metric_students_at_risk}}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{#str}}metric_pending_actions, local_earlyalert{{/str}}</div>
                        <div class="display-6 fw-bold">{{metric_pending_actions}}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white">
                <h2 class="h4 mb-0">{{#str}}active_courses, local_earlyalert{{/str}}</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                    <tr>
                        <th>{{#str}}course_code_title, local_earlyalert{{/str}}</th>
                        <th>{{#str}}enrollment, local_earlyalert{{/str}}</th>
                        <th>{{#str}}alerts_term, local_earlyalert{{/str}}</th>
                        <th>{{#str}}risk_level, local_earlyalert{{/str}}</th>
                        <th class="text-end">{{#str}}actions, core{{/str}}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#courses}}
                        <tr

                            class="ea-course-row">
                            <td>
                                <div class="fw-semibold">{{fullname}}</div>
                            </td>
                            <td>{{enrollment}}</td>
                            <td>{{alerts}}</td>
                            <td>
                                <span class="badge bg-{{riskbadge}}">{{risklevel}}</span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        data-action="earlyalert/select-course"
                                        data-course-id="{{id}}"
                                        data-course-name="{{fullname}}">
                                    {{#str}}start_alert_flow, local_earlyalert{{/str}}
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm btn-course-overview"
                                        data-course-id="{{id}}">
                                    {{#str}}course_overview, local_earlyalert{{/str}}
                                </button>
                            </td>
                        </tr>
                    {{/courses}}
                    {{^has_courses}}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">{{#str}}no_courses, local_earlyalert{{/str}}</td>
                        </tr>
                    {{/has_courses}}
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Course overview -->
        <div class="card mt-3 ea-course-overview-container">
            <div class="card-body">
                <div id="early-alert-student-results" class="mt-3"></div>
            </div>
        </div>
    </div>

    <div id="earlyalert-workflow-view" data-region="workflow-view" class="d-none">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <div class="text-muted small mb-1">
                    <a id="ea-selected-course-link" href="#" class="text-decoration-none"></a>
                </div>
                <h2 id="ea-workflow-title" class="h3 mb-0">{{#str}}send_early_alert, local_earlyalert{{/str}}</h2>
            </div>
            <button type="button" class="btn btn-link"
                    data-action="earlyalert/back-dashboard">{{#str}}back_to_dashboard, local_earlyalert{{/str}}</button>
        </div>

        <div class="card">
            <div class="card-body border-bottom">
                <div class="ea-steps d-flex align-items-center gap-4" data-region="wizard-steps">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-primary" data-step="1"
                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">1</span>
                        <span class="ea-step-label" data-step="1">{{#str}}alert_type, local_earlyalert{{/str}}</span>
                    </div>
                    <div class="flex-grow-1" style="height:2px;background:#dee2e6;"></div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-secondary" data-step="2"
                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">2</span>
                        <span class="ea-step-label" data-step="2">{{#str}}grade_threshold_and_students, local_earlyalert{{/str}}</span>
                    </div>
                    <div class="flex-grow-1" style="height:2px;background:#dee2e6;"></div>
<!--                    <div class="d-flex align-items-center gap-2">-->
<!--                        <span class="badge rounded-circle bg-secondary" data-step="3"-->
<!--                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">3</span>-->
<!--                        <span class="ea-step-label" data-step="3">{{#str}}compose_and_send, local_earlyalert{{/str}}</span>-->
<!--                    </div>-->
                </div>
            </div>

            <div class="card-body" data-region="step-1">
                <h3 class="h4">{{#str}}choose_alert_type, local_earlyalert{{/str}}</h3>
                <p class="text-muted">{{#str}}choose_alert_type_help, local_earlyalert{{/str}}</p>
                <div class="card-group" data-region="alert-type-cards">
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="grade">
                                <span class="d-block fw-semibold">{{#str}}low_grade, local_earlyalert{{/str}}</span>
                                <span class="text-muted small">{{#str}}alert_type_low_grade_help, local_earlyalert{{/str}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="assign">
                                <span class="d-block fw-semibold">{{#str}}missed_assignment, local_earlyalert{{/str}}</span>
                                <span class="text-muted small">{{#str}}alert_type_assignment_help, local_earlyalert{{/str}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="exam">
                                <span class="d-block fw-semibold">{{#str}}missed_exam, local_earlyalert{{/str}}</span>
                                <span class="text-muted small">{{#str}}alert_type_exam_help, local_earlyalert{{/str}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-success rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="commendation">
                                <span class="d-block fw-semibold">{{#str}}alert_type_commendation, local_earlyalert{{/str}}</span>
                                <span class="text-muted small">{{#str}}alert_type_commendation_help, local_earlyalert{{/str}}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body d-none" data-region="step-2">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="text-muted small">{{#str}}selected_alert_type, local_earlyalert{{/str}}:</span>
                    <span class="badge bg-light text-dark border" id="ea-step-2-alert-type"></span>
                </div>
                <div class="accordion mb-3" id="ea-step-2-criteria-help-accordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="ea-step-2-criteria-help-heading">
                            <button class="accordion-button collapsed bg-secondary" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#ea-step-2-criteria-help-collapse" aria-expanded="false"
                                    aria-controls="ea-step-2-criteria-help-collapse">
                                {{#str}}alert_criteria_help_title, local_earlyalert{{/str}}
                            </button>
                        </h2>
                        <div id="ea-step-2-criteria-help-collapse" class="accordion-collapse collapse"
                             aria-labelledby="ea-step-2-criteria-help-heading"
                             data-bs-parent="#ea-step-2-criteria-help-accordion">
                            <div class="accordion-body">
                                <div class="alert alert-info mb-0" role="alert"
                                     id="ea-instructions-grade">
                                    {{#str}}grade_instructions, local_earlyalert{{/str}}
                                </div>
                                <div class="alert alert-info mb-0 d-none" role="alert"
                                     id="ea-instructions-assign">
                                    {{#str}}assignment_instructions, local_earlyalert{{/str}}
                                </div>
                                <div class="alert alert-info mb-0 d-none" role="alert"
                                     id="ea-instructions-exam">
                                    {{#str}}exam_instructions, local_earlyalert{{/str}}
                                </div>
                                <div class="alert alert-info mb-0 d-none" role="alert"
                                     id="ea-instructions-commendation">
                                    {{#str}}commendation_instructions, local_earlyalert{{/str}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-xl-4">
                        <div class="card h-100">
                            <div class="card-header bg-white">
                                <h3 class="h5 mb-0">{{#str}}alert_criteria, local_earlyalert{{/str}}</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="ea-include-all-students">
                                    <label class="form-check-label"
                                           for="ea-include-all-students">{{#str}}not_using_gradebook, local_earlyalert{{/str}}</label>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">{{#str}}condition, local_earlyalert{{/str}}</label>
                                    <div id="ea-condition-display" class="form-control-plaintext fw-semibold"></div>
                                    <div class="form-text">{{#str}}condition_locked_help, local_earlyalert{{/str}}</div>
                                </div>
                                <div class="mb-3" id="ea-threshold-wrap">
                                    <label class="form-label" for="ea-threshold-mode">{{#str}}threshold, local_earlyalert{{/str}}</label>
                                    <select id="ea-threshold-mode" class="form-select mb-2">
                                        <option value="letter" selected>{{#str}}threshold_mode_letter, local_earlyalert{{/str}}</option>
                                        <option value="percent">{{#str}}threshold_mode_percent, local_earlyalert{{/str}}</option>
                                    </select>
                                    <div id="ea-threshold-letter-wrap">
                                        <select id="ea-grade-threshold" class="form-select">
                                            <option value="10">F (0-39%)</option>
                                            <option value="9">E (40-49%)</option>
                                            <option value="8">D (50-54%)</option>
                                            <option value="7" selected>D+ (55-59%)</option>
                                            <option value="6">C (60-64%)</option>
                                            <option value="5">C+ (65-69%)</option>
                                            <option value="4">B (70-74%)</option>
                                            <option value="3">B+ (75-79%)</option>
                                            <option value="2">A (80-89%)</option>
                                            <option value="1">A+ (90-100%)</option>
                                        </select>
                                    </div>
                                    <div id="ea-threshold-percent-wrap" class="d-none">
                                        <div class="input-group">
                                            <input type="number" id="ea-threshold-percent" class="form-control" min="0"
                                                   max="100" step="0.1" value="55" placeholder="55.0">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="form-text">{{#str}}threshold_help, local_earlyalert{{/str}}</div>
                                </div>

                                <div class="mb-3 d-none" id="ea-assignment-title-wrap">
                                    <div class="d-flex align-items-center">
                                        <p class="mb-0 me-2"><b>{{#str}}assignment_title, local_earlyalert{{/str}}:</b></p>
                                        <input type="text" id="early-alert-assignment-title" class="form-control" style="max-width: 320px;" placeholder="Enter the assignment title">
                                    </div>
                                    <small class="text-body-primary">{{#str}}assignment_title_required, local_earlyalert{{/str}}</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label"
                                           for="ea-grade-filter-mode">{{#str}}filter_on, local_earlyalert{{/str}}</label>
                                    <select id="ea-grade-filter-mode" class="form-select">
                                        <option value="course" selected>{{#str}}overall_course_grade, local_earlyalert{{/str}}</option>
                                        <option value="single">{{#str}}single_assignment_quiz, local_earlyalert{{/str}}</option>
                                        <option value="multi">{{#str}}multi_assignments_quizzes, local_earlyalert{{/str}}</option>
                                    </select>
                                </div>
                                <div class="mb-3" id="ea-grade-items-wrap">
                                    <label class="form-label" for="ea-grade-items">{{#str}}grade_items, local_earlyalert{{/str}}</label>
                                    <select id="ea-grade-items" class="form-select" multiple size="6"></select>
                                    <div class="form-text">{{#str}}grade_items_help, local_earlyalert{{/str}}</div>
                                </div>
                                <div id="ea-filter-mode-container">
                                    <div class="mb-3 d-none" id="ea-multi-mode-wrap">
                                        <label class="form-label">{{#str}}multi_mode, local_earlyalert{{/str}}</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-any" value="any" checked>
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-any">{{#str}}multi_mode_any, local_earlyalert{{/str}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-average" value="average">
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-average">{{#str}}multi_mode_average, local_earlyalert{{/str}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-weighted" value="weighted">
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-weighted">{{#str}}multi_mode_weighted, local_earlyalert{{/str}}</label>
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        <button type="button" class="btn btn-outline-primary w-100"
                                                data-action="earlyalert/apply-filters">
                                            {{#str}}apply_filter, local_earlyalert{{/str}}
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-xl-8">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                            <h3 class="h5 mb-0">{{#str}}flagged_students, local_earlyalert{{/str}}</h3>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm d-none"
                                        id="ea-edit-custom-message-btn"
                                        data-action="earlyalert/open-custom-message">
                                    {{#str}}edit_message, local_earlyalert{{/str}}
                                </button>
                                <div class="text-danger fw-semibold" id="ea-selected-count">0 {{#str}}selected, local_earlyalert{{/str}}</div>
                                <div class="text-muted small"
                                     id="ea-table-range">{{#str}}showing_range_default, local_earlyalert{{/str}}</div>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/clear-selection">{{#str}}clear_selection, local_earlyalert{{/str}}</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/export-selected">{{#str}}export_csv, local_earlyalert{{/str}}</button>
                            </div>
                        </div>
                        <div class="input-group mb-2">
                            <input type="search" id="ea-search" class="form-control"
                                   placeholder="{{#str}}search_students, local_earlyalert{{/str}}">
                            <button class="btn btn-outline-secondary" type="button"
                                    data-action="earlyalert/search">{{#str}}search, core{{/str}}</button>
                        </div>
                        <div class="table-responsive border rounded">
                            <table class="table table-sm table-hover mb-0" id="ea-students-table">
                                <thead>
                                <tr>
                                    <th style="width:40px;"><input type="checkbox" id="ea-check-all-page"></th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="name">
                                            {{#str}}student_name, local_earlyalert{{/str}} <span id="ea-sort-indicator-name">-</span>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="idnumber">
                                            {{#str}}student_id, local_earlyalert{{/str}} <span id="ea-sort-indicator-idnumber">-</span>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="grade">
                                            {{#str}}grade, local_earlyalert{{/str}} <span id="ea-sort-indicator-grade">-</span>
                                        </button>
                                    </th>
                                    <th>{{#str}}matched_items, local_earlyalert{{/str}}</th>
                                    <th class="text-end">{{#str}}preview, local_earlyalert{{/str}}</th>
                                </tr>
                                </thead>
                                <tbody data-region="students-table-body">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">{{#str}}loading, local_earlyalert{{/str}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label class="small text-muted mb-0"
                                       for="ea-per-page">{{#str}}items_per_page, local_earlyalert{{/str}}</label>
                                <select id="ea-per-page" class="form-select form-select-sm" style="width:auto;">
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small" id="ea-pagination-summary"></span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-action="earlyalert/prev-page">{{#str}}previous, core{{/str}}</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-action="earlyalert/next-page">{{#str}}next, core{{/str}}</button>
                                </div>
                                <label class="small text-muted mb-0" for="ea-page-input">{{#str}}go_to_page, local_earlyalert{{/str}}</label>
                                <input type="number" id="ea-page-input" class="form-control form-control-sm" min="1"
                                       value="1" style="width:90px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/go-page">Go
                                </button>
                                <span class="small text-muted" id="ea-total-pages">{{#str}}of_pages, local_earlyalert, {total}{{/str}}</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-action="earlyalert/back-step-1">
                                {{#str}}back, core{{/str}}
                            </button>
                            <button type="button" class="btn btn-danger" data-action="earlyalert/send-alerts">
                                {{#str}}send_alert_now, local_earlyalert{{/str}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

<!--            <div class="card-body d-none" data-region="step-3">-->
<!--                <h3 class="h4">{{#str}}compose_message, local_earlyalert{{/str}}</h3>-->
<!--                <div class="d-flex align-items-center gap-2 mb-2">-->
<!--                    <span class="text-muted small">{{#str}}selected_alert_type, local_earlyalert{{/str}}:</span>-->
<!--                    <span class="badge bg-light text-dark border" id="ea-step-3-alert-type"></span>-->
<!--                </div>-->
<!--                <p class="text-muted" id="ea-compose-summary"></p>-->

<!--                <div class="alert alert-info border mb-3">-->
<!--                    {{#str}}etemplate_template_note, local_earlyalert{{/str}}-->
<!--                </div>-->

<!--                <div class="alert alert-light border" id="ea-message-preview-container">-->
<!--                    <div class="fw-semibold mb-1">{{#str}}resolved_preview, local_earlyalert{{/str}}</div>-->
<!--                    <div class="text-muted small mb-2">{{#str}}resolved_preview_note, local_earlyalert{{/str}}</div>-->
<!--                    <div id="ea-message-preview-subject" class="fw-semibold mb-2"></div>-->
<!--                    <div id="ea-message-preview-text" class="text-muted">{{#str}}preview_message_placeholder, local_earlyalert{{/str}}</div>-->
<!--                </div>-->

<!--                <div class="d-flex justify-content-between">-->
<!--                    <button type="button" class="btn btn-outline-secondary"-->
<!--                            data-action="earlyalert/back-step-2">{{#str}}back, core{{/str}}</button>-->
<!--                    <button type="button" class="btn btn-danger" data-action="earlyalert/send-alerts">-->
<!--                        {{#str}}send_alert_now, local_earlyalert{{/str}}-->
<!--                    </button>-->
<!--                </div>-->
        </div>
    </div>

    <div class="modal fade" id="ea-preview-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="ea-preview-modal-title">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="ea-preview-modal-title">{{#str}}message_preview, local_earlyalert{{/str}}</h5>
                    </div>
                    <button type="button" class="btn-close" data-action="earlyalert/close-preview"
                            aria-label="{{#str}}close, local_earlyalert{{/str}}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <span class="fw-semibold">{{#str}}subject_line, local_earlyalert{{/str}}:</span>
                        <span id="ea-preview-modal-subject"></span>
                    </div>
                    <div id="ea-preview-modal-body"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-action="earlyalert/close-preview">{{#str}}close, local_earlyalert{{/str}}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ea-custom-message-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="ea-custom-message-modal-title">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ea-custom-message-modal-title">{{#str}}edit_message, local_earlyalert{{/str}}</h5>
                    <button type="button" class="btn-close" data-action="earlyalert/close-custom-message"
                            aria-label="{{#str}}close, local_earlyalert{{/str}}"></button>
                </div>
                <div class="modal-body">
                    <label for="ea-custom-message-modal-text" class="form-label">{{#str}}additional_message, local_earlyalert{{/str}}</label>
                    <textarea id="ea-custom-message-modal-text" class="form-control" rows="6"></textarea>
                    <div class="form-text">{{#str}}additional_message_help, local_earlyalert{{/str}}</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-action="earlyalert/close-custom-message">{{#str}}cancel, core{{/str}}</button>
                    <button type="button" class="btn btn-primary"
                            data-action="earlyalert/save-custom-message">{{#str}}save_changes, local_earlyalert{{/str}}</button>
                </div>
            </div>
        </div>
    </div>
</div>
