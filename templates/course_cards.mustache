<div class="earlyalert-redesign" id="earlyalert-dashboard"
     data-teacher-user-id="{{teacher_user_id}}"
     data-show-grades="{{show_grades}}">
    <input type="hidden" id="early-alert-teacher-user-id" value="{{teacher_user_id}}">

    {{#impersonate}}
        <div class="row mb-4">
            <div class="col-md-4">
                <label for="search" class="form-label">{{strings.impersonate_user}}</label>
                <select id="search" class="form-select" data-placeholder="{{strings.search}}">
                    <option value="{{impersonate_selected_user_id}}"
                            selected>{{impersonate_selected_user_label}}</option>
                </select>
            </div>
        </div>
    {{/impersonate}}

    <div id="earlyalert-dashboard-view" data-region="dashboard-view">
        <!-- Title removed per design -->

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{strings.metric_total_alerts}}</div>
                        <div class="display-6 fw-bold">{{metric_total_alerts}}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{strings.metric_students_at_risk}}</div>
                        <div class="display-6 fw-bold">{{metric_students_at_risk}}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card ea-metric-card h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase">{{strings.metric_pending_actions}}</div>
                        <div class="display-6 fw-bold">{{metric_pending_actions}}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white">
                <h2 class="h4 mb-0">{{strings.active_courses}}</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                    <tr>
                        <th>{{strings.course_code_title}}</th>
                        <th>{{strings.enrollment}}</th>
                        <th>{{strings.alerts_term}}</th>
                        <th>{{strings.risk_level}}</th>
                        <th class="text-end">{{strings.actions}}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#courses}}
                        <tr

                            class="ea-course-row">
                            <td>
                                <div class="fw-semibold">{{fullname}}</div>
                            </td>
                            <td>{{enrollment}}</td>
                            <td>{{alerts}}</td>
                            <td>
                                <span class="badge bg-{{riskbadge}}">{{risklevel}}</span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        data-action="earlyalert/select-course"
                                        data-course-id="{{id}}"
                                        data-course-name="{{fullname}}">
                                    {{strings.start_alert_flow}}
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm btn-course-overview"
                                        data-course-id="{{id}}">
                                    {{strings.course_overview}}
                                </button>
                            </td>
                        </tr>
                    {{/courses}}
                    {{^has_courses}}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">{{strings.no_courses}}</td>
                        </tr>
                    {{/has_courses}}
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Course overview -->
        <div class="card mt-3 ea-course-overview-container">
            <div class="card-body">
                <div id="early-alert-student-results" class="mt-3"></div>
            </div>
        </div>
    </div>

    <div id="earlyalert-workflow-view" data-region="workflow-view" class="d-none">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <div class="text-muted small mb-1">
                    <a id="ea-selected-course-link" href="#" class="text-decoration-none"></a>
                </div>
                <h2 id="ea-workflow-title" class="h3 mb-0">{{strings.send_early_alert}}</h2>
            </div>
            <button type="button" class="btn btn-link"
                    data-action="earlyalert/back-dashboard">{{strings.back_to_dashboard}}</button>
        </div>

        <div class="card">
            <div class="card-body border-bottom">
                <div class="ea-steps d-flex align-items-center gap-4" data-region="wizard-steps">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-primary" data-step="1"
                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">1</span>
                        <span class="ea-step-label" data-step="1">{{strings.alert_type}}</span>
                    </div>
                    <div class="flex-grow-1" style="height:2px;background:#dee2e6;"></div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-secondary" data-step="2"
                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">2</span>
                        <span class="ea-step-label" data-step="2">{{strings.grade_threshold_and_students}}</span>
                    </div>
                    <div class="flex-grow-1" style="height:2px;background:#dee2e6;"></div>
<!--                    <div class="d-flex align-items-center gap-2">-->
<!--                        <span class="badge rounded-circle bg-secondary" data-step="3"-->
<!--                              style="min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;">3</span>-->
<!--                        <span class="ea-step-label" data-step="3">{{strings.compose_and_send}}</span>-->
<!--                    </div>-->
                </div>
            </div>

            <div class="card-body" data-region="step-1">
                <h3 class="h4">{{strings.choose_alert_type}}</h3>
                <p class="text-muted">{{strings.choose_alert_type_help}}</p>
                <div class="card-group" data-region="alert-type-cards">
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="grade">
                                <span class="d-block fw-semibold">{{strings.low_grade}}</span>
                                <span class="text-muted small">{{strings.alert_type_low_grade_help}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="assign">
                                <span class="d-block fw-semibold">{{strings.missed_assignment}}</span>
                                <span class="text-muted small">{{strings.alert_type_assignment_help}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-danger rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="exam">
                                <span class="d-block fw-semibold">{{strings.missed_exam}}</span>
                                <span class="text-muted small">{{strings.alert_type_exam_help}}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <button type="button"
                                    class="btn btn-outline-success rounded-0 w-100 h-100 text-start ea-alert-option d-flex flex-column align-items-start justify-content-start px-3 py-3"
                                    data-alert-type="commendation">
                                <span class="d-block fw-semibold">{{strings.alert_type_commendation}}</span>
                                <span class="text-muted small">{{strings.alert_type_commendation_help}}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body d-none" data-region="step-2">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="text-muted small">{{strings.selected_alert_type}}:</span>
                    <span class="badge bg-light text-dark border" id="ea-step-2-alert-type"></span>
                </div>
                <div class="accordion mb-3" id="ea-step-2-criteria-help-accordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="ea-step-2-criteria-help-heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#ea-step-2-criteria-help-collapse" aria-expanded="false"
                                    aria-controls="ea-step-2-criteria-help-collapse">
                                {{strings.alert_criteria_help_title}}
                            </button>
                        </h2>
                        <div id="ea-step-2-criteria-help-collapse" class="accordion-collapse collapse"
                             aria-labelledby="ea-step-2-criteria-help-heading"
                             data-bs-parent="#ea-step-2-criteria-help-accordion">
                            <div class="accordion-body">
                                <div class="alert alert-info mb-0" role="alert">
                                    {{{strings.grade_instructions}}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-xl-4">
                        <div class="card h-100">
                            <div class="card-header bg-white">
                                <h3 class="h5 mb-0">{{strings.alert_criteria}}</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="ea-include-all-students">
                                    <label class="form-check-label"
                                           for="ea-include-all-students">{{strings.not_using_gradebook}}</label>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">{{strings.condition}}</label>
                                    <div id="ea-condition-display" class="form-control-plaintext fw-semibold"></div>
                                    <div class="form-text">{{strings.condition_locked_help}}</div>
                                </div>
                                <div class="mb-3" id="ea-threshold-wrap">
                                    <label class="form-label" for="ea-threshold-mode">{{strings.threshold}}</label>
                                    <select id="ea-threshold-mode" class="form-select mb-2">
                                        <option value="letter" selected>{{strings.threshold_mode_letter}}</option>
                                        <option value="percent">{{strings.threshold_mode_percent}}</option>
                                    </select>
                                    <div id="ea-threshold-letter-wrap">
                                        <select id="ea-grade-threshold" class="form-select">
                                            <option value="10">F (0-39%)</option>
                                            <option value="9">E (40-49%)</option>
                                            <option value="8">D (50-54%)</option>
                                            <option value="7" selected>D+ (55-59%)</option>
                                            <option value="6">C (60-64%)</option>
                                            <option value="5">C+ (65-69%)</option>
                                            <option value="4">B (70-74%)</option>
                                            <option value="3">B+ (75-79%)</option>
                                            <option value="2">A (80-89%)</option>
                                            <option value="1">A+ (90-100%)</option>
                                        </select>
                                    </div>
                                    <div id="ea-threshold-percent-wrap" class="d-none">
                                        <div class="input-group">
                                            <input type="number" id="ea-threshold-percent" class="form-control" min="0"
                                                   max="100" step="0.1" value="55" placeholder="55.0">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="form-text">{{strings.threshold_help}}</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label"
                                           for="ea-grade-filter-mode">{{strings.filter_on}}</label>
                                    <select id="ea-grade-filter-mode" class="form-select">
                                        <option value="course" selected>{{strings.overall_course_grade}}</option>
                                        <option value="single">{{strings.single_assignment_quiz}}</option>
                                        <option value="multi">{{strings.multi_assignments_quizzes}}</option>
                                    </select>
                                </div>
                                <div class="mb-3" id="ea-grade-items-wrap">
                                    <label class="form-label" for="ea-grade-items">{{strings.grade_items}}</label>
                                    <select id="ea-grade-items" class="form-select" multiple size="6"></select>
                                    <div class="form-text">{{strings.grade_items_help}}</div>
                                </div>
                                <div id="ea-filter-mode-container">
                                    <div class="mb-3 d-none" id="ea-multi-mode-wrap">
                                        <label class="form-label">{{strings.multi_mode}}</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-any" value="any" checked>
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-any">{{strings.multi_mode_any}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-average" value="average">
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-average">{{strings.multi_mode_average}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ea-multi-mode"
                                                   id="ea-multi-mode-weighted" value="weighted">
                                            <label class="form-check-label"
                                                   for="ea-multi-mode-weighted">{{strings.multi_mode_weighted}}</label>
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        <button type="button" class="btn btn-outline-primary w-100"
                                                data-action="earlyalert/apply-filters">
                                            {{strings.apply_filter}}
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-xl-8">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                            <h3 class="h5 mb-0">{{strings.flagged_students}}</h3>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm d-none"
                                        id="ea-edit-custom-message-btn"
                                        data-action="earlyalert/open-custom-message">
                                    {{strings.edit_message}}
                                </button>
                                <div class="text-danger fw-semibold" id="ea-selected-count">0 {{strings.selected}}</div>
                                <div class="text-muted small"
                                     id="ea-table-range">{{strings.showing_range_default}}</div>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/clear-selection">{{strings.clear_selection}}</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/export-selected">{{strings.export_csv}}</button>
                            </div>
                        </div>
                        <div class="input-group mb-2">
                            <input type="search" id="ea-search" class="form-control"
                                   placeholder="{{strings.search_students}}">
                            <button class="btn btn-outline-secondary" type="button"
                                    data-action="earlyalert/search">{{strings.search}}</button>
                        </div>
                        <div class="table-responsive border rounded">
                            <table class="table table-sm table-hover mb-0" id="ea-students-table">
                                <thead>
                                <tr>
                                    <th style="width:40px;"><input type="checkbox" id="ea-check-all-page"></th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="name">
                                            {{strings.student_name}} <span id="ea-sort-indicator-name">-</span>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="idnumber">
                                            {{strings.student_id}} <span id="ea-sort-indicator-idnumber">-</span>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                                data-action="earlyalert/sort" data-sort-by="grade">
                                            {{strings.grade}} <span id="ea-sort-indicator-grade">-</span>
                                        </button>
                                    </th>
                                    <th>{{strings.matched_items}}</th>
                                    <th class="text-end">{{strings.preview}}</th>
                                </tr>
                                </thead>
                                <tbody data-region="students-table-body">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">{{strings.loading}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label class="small text-muted mb-0"
                                       for="ea-per-page">{{strings.items_per_page}}</label>
                                <select id="ea-per-page" class="form-select form-select-sm" style="width:auto;">
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small" id="ea-pagination-summary"></span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-action="earlyalert/prev-page">{{strings.previous}}</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-action="earlyalert/next-page">{{strings.next}}</button>
                                </div>
                                <label class="small text-muted mb-0" for="ea-page-input">{{strings.go_to_page}}</label>
                                <input type="number" id="ea-page-input" class="form-control form-control-sm" min="1"
                                       value="1" style="width:90px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="earlyalert/go-page">Go
                                </button>
                                <span class="small text-muted" id="ea-total-pages">{{strings.of_pages}}</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-action="earlyalert/back-step-1">
                                {{strings.back}}
                            </button>
                            <button type="button" class="btn btn-danger" data-action="earlyalert/send-alerts">
                                {{strings.send_alert_now}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

<!--            <div class="card-body d-none" data-region="step-3">-->
<!--                <h3 class="h4">{{strings.compose_message}}</h3>-->
<!--                <div class="d-flex align-items-center gap-2 mb-2">-->
<!--                    <span class="text-muted small">{{strings.selected_alert_type}}:</span>-->
<!--                    <span class="badge bg-light text-dark border" id="ea-step-3-alert-type"></span>-->
<!--                </div>-->
<!--                <p class="text-muted" id="ea-compose-summary"></p>-->

<!--                <div class="alert alert-info border mb-3">-->
<!--                    {{strings.etemplate_template_note}}-->
<!--                </div>-->

<!--                <div class="alert alert-light border" id="ea-message-preview-container">-->
<!--                    <div class="fw-semibold mb-1">{{strings.resolved_preview}}</div>-->
<!--                    <div class="text-muted small mb-2">{{strings.resolved_preview_note}}</div>-->
<!--                    <div id="ea-message-preview-subject" class="fw-semibold mb-2"></div>-->
<!--                    <div id="ea-message-preview-text" class="text-muted">{{strings.preview_message_placeholder}}</div>-->
<!--                </div>-->

<!--                <div class="d-flex justify-content-between">-->
<!--                    <button type="button" class="btn btn-outline-secondary"-->
<!--                            data-action="earlyalert/back-step-2">{{strings.back}}</button>-->
<!--                    <button type="button" class="btn btn-danger" data-action="earlyalert/send-alerts">-->
<!--                        {{strings.send_alert_now}}-->
<!--                    </button>-->
<!--                </div>-->
            </div>
        </div>
    </div>

    <div class="modal fade" id="ea-preview-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="ea-preview-modal-title">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="ea-preview-modal-title">{{strings.message_preview}}</h5>
                        <div class="text-muted small"><span>{{strings.to_label}}:</span> <span
                                id="ea-preview-modal-recipient"></span></div>
                    </div>
                    <button type="button" class="btn-close" data-action="earlyalert/close-preview"
                            aria-label="{{strings.close}}"></button>
                </div>
                <div class="modal-body" id="ea-preview-modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-action="earlyalert/close-preview">{{strings.close}}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ea-custom-message-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="ea-custom-message-modal-title">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ea-custom-message-modal-title">{{strings.edit_message}}</h5>
                    <button type="button" class="btn-close" data-action="earlyalert/close-custom-message"
                            aria-label="{{strings.close}}"></button>
                </div>
                <div class="modal-body">
                    <label for="ea-custom-message-modal-text" class="form-label">{{strings.additional_message}}</label>
                    <textarea id="ea-custom-message-modal-text" class="form-control" rows="6"></textarea>
                    <div class="form-text">{{strings.additional_message_help}}</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-action="earlyalert/close-custom-message">{{strings.cancel}}</button>
                    <button type="button" class="btn btn-primary"
                            data-action="earlyalert/save-custom-message">{{strings.save_changes}}</button>
                </div>
            </div>
        </div>
    </div>
</div>
